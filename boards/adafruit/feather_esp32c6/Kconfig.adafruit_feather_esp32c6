config BOARD_ADAFRUIT_FEATHER_ESP32C6
	# The Feather C6 carries an ESP32-C6-MINI-1 module with 4 MB flash and
	# no PSRAM; the N4 WROOM SoC profile matches (4 MB flash, single-U).
	select SOC_ESP32_C6_WROOM_1U_N4
	select SOC_ESP32C6_HPCORE if BOARD_ADAFRUIT_FEATHER_ESP32C6_ESP32C6_HPCORE
	select SOC_ESP32C6_LPCORE if BOARD_ADAFRUIT_FEATHER_ESP32C6_ESP32C6_LPCORE
