/*
 * Application devicetree overlay — devices on the STEMMA QT / Feather I2C bus.
 *
 * Zephyr picks up "app.overlay" from the application directory automatically
 * and merges it on top of the board devicetree. The board already sets i2c0
 * to "okay" with its pinctrl; here we just declare what's plugged into it.
 */

#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>

/ {
	chosen {
		zephyr,display = &tft;
	};

	/*
	 * Adafruit 2.4" TFT FeatherWing: ILI9341 on SPI, with a GPIO
	 * data/command line. Wiring is documented in the board DTS.
	 */
	tft_mipi_dbi: tft-mipi-dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;	/* D10 */
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * The panel is an ILI9341, but driven as an ILI9340 (same
		 * controller family). The ili9340 orientation table matches
		 * Adafruit's library and Zephyr's in-tree Adafruit TFT shield;
		 * the ili9341 one sets MADCTL differently (e.g. MV|MY at 90).
		 * 270 = MADCTL MV|MX|MY, which is the right way up with the
		 * FeatherWing as mounted in the box.
		 */
		tft: ili9340@0 {
			compatible = "ilitek,ili9340";
			reg = <0>;
			mipi-max-frequency = <24000000>;
			/*
			 * Native (portrait) panel size. The driver swaps these
			 * itself for 90/270, giving a 320x240 landscape screen.
			 */
			width = <240>;
			height = <320>;
			rotation = <270>;
			/*
			 * RGB888 rather than RGB565: LVGL 9 renders RGB565
			 * little-endian and nothing in the Zephyr display path
			 * byte-swaps it for the panel, so 565 colours come out
			 * garbled. Same choice as Zephyr's Adafruit TFT shield.
			 */
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
		};
	};
};

&spi2 {
	cs-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;	/* D9: TFT_CS */
};

&gpio0 {
	/*
	 * The FeatherWing's microSD slot and STMPE610 touch controller share
	 * the SPI bus but are unused. Hold their chip-selects inactive (high)
	 * so they never drive MISO.
	 */
	sd-cs-hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_LOW>;	/* D5: SD_CS */
		output-low;
	};

	touch-cs-hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_LOW>;	/* D6: TOUCH_CS */
		output-low;
	};
};

&i2c0 {
	/*
	 * Drop from the board default (Fast, 400 kHz) to Standard (100 kHz).
	 * Four devices daisy-chained on STEMMA QT cables add enough bus
	 * capacitance to cause intermittent -EFAULT at 400 kHz.
	 */
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/* Adafruit BME280 breakout, default (secondary) address. */
	bme280: bme280@77 {
		compatible = "bosch,bme280";
		reg = <0x77>;
	};

	/* Adafruit TSL2591 high-dynamic-range light sensor. */
	tsl2591: tsl2591@29 {
		compatible = "ams,tsl2591";
		reg = <0x29>;
	};

	/* On-board MAX17048 LiPo fuel gauge (fuel-gauge API, not sensor API). */
	max17048: max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
	};

	/* Adafruit PMSA003I particulate matter sensor (out-of-tree driver). */
	pmsa003i: pmsa003i@12 {
		compatible = "plantower,pmsa003i";
		reg = <0x12>;
	};

	/* Adafruit SGP30 eCO2 / TVOC sensor (out-of-tree driver). */
	sgp30: sgp30@58 {
		compatible = "sensirion,sgp30";
		reg = <0x58>;
	};

	/*
	 * Adafruit SCD-43 true (NDIR photoacoustic) CO2 sensor. Zephyr's scd4x
	 * driver knows the SCD40 and SCD41; the SCD43 shares the SCD41's command
	 * set, so it's declared as one. Until it's plugged in, its driver fails
	 * to initialise at boot (one error in the log) and the CO2 tile says
	 * "no sensor".
	 */
	scd4x: scd4x@62 {
		compatible = "sensirion,scd41";
		reg = <0x62>;
		mode = <0>;	/* periodic, a measurement every 5 s */
	};
};

/*
 * TFT backlight. The FeatherWing's LITE pad is not connected to any header
 * pin from the factory; in this box it is hand-wired to Feather A5 (IO2).
 * LITE high = backlight on, low = off, and it accepts PWM for dimming.
 * Driven by LEDC channel 0.
 */
&pinctrl {
	ledc0_backlight: ledc0_backlight {
		group1 {
			pinmux = <LEDC_CH0_GPIO2>;
			output-enable;
		};
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_backlight>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

/ {
	backlight {
		compatible = "pwm-leds";

		/* 5 kHz: well above visible flicker. */
		tft_backlight: tft-backlight {
			pwms = <&ledc0 0 PWM_USEC(200) PWM_POLARITY_NORMAL>;
		};
	};
};

/*
 * Split the 192 KB "storage" partition: the settings store (NVS: SGP30
 * baseline, Wi-Fi credentials) keeps the first 64 KB, of which it uses the
 * first 32 KB, so its data is untouched; the hourly long-term history
 * (src/ltlog.c) gets the remaining 128 KB, about 4.3 months of records.
 * Flashing the firmware touches neither.
 */
&storage_partition {
	reg = <0x3b0000 DT_SIZE_K(64)>;
};

&flash0 {
	partitions {
		history_partition: partition@3c0000 {
			label = "history";
			reg = <0x3c0000 DT_SIZE_K(128)>;
		};
	};
};
